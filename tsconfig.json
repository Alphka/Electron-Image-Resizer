{
	"compilerOptions": {
		"module": "ESNext",
		"target": "ES2022",
		"allowJs": true,
		"strict": true,
		"jsx": "react-jsx",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"lib": [
			"DOM",
			"DOM.Iterable",
			"ESNext"
		],
		"sourceMap": true,
		"outDir": "dist"
	}
}
